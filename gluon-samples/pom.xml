<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.javafx.examples</groupId>
        <artifactId>javafx-examples</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <groupId>com.gluonhq.samples</groupId>
    <artifactId>gluon-samples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Gluon Samples</name>

    <modules>
        <module>HelloWorld</module>
        <module>HelloFX</module>
        <module>HelloFXML</module>
        <module>HelloGluon</module>

        <module>beacons</module>
        <module>cloudlink-cloudfirst-storage</module>
        <module>comments</module>
        <module>doodle-trace</module>
        <module>fiftystates</module>
        <module>connect-basic-usage</module>
        <module>connect-file-provider</module>
        <module>connect-rest-provider</module>
        <module>hellotribuo</module>
        <module>notes</module>
        <module>pushnotes</module>
    </modules>

    <properties>
        <!--dependencies-->
        <charm.version>6.0.6</charm.version>
        <glisten.afterburner.version>2.0.5</glisten.afterburner.version>
        <attach.version>4.0.15</attach.version>
        <connect.version>2.0.1</connect.version>
        <jaxb-runtime.version>4.0.0</jaxb-runtime.version>
        <jakarta.json.version>2.0.1</jakarta.json.version>
        <!--plugins-->
        <client.maven.plugin.version>0.1.35</client.maven.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gluonhq</groupId>
                <artifactId>glisten-afterburner</artifactId>
                <version>${glisten.afterburner.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.gluonhq</groupId>
                <artifactId>charm-glisten</artifactId>
                <version>${charm.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.gluonhq</groupId>
                <artifactId>charm-cloudlink-client</artifactId>
                <version>${charm.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.openjfx</groupId>
                        <artifactId>*</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>display</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>lifecycle</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>statusbar</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>storage</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>util</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>com.gluonhq.attach</groupId>
                <artifactId>ble</artifactId>
                <version>${attach.version}</version>
            </dependency>
            <dependency>
                <groupId>org.glassfish</groupId>
                <artifactId>jakarta.json</artifactId>
                <version>${jakarta.json.version}</version>
                <classifier>module</classifier>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
                <scope>runtime</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
